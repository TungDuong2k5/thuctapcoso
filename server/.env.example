PORT=5050
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-bi-mat
JWT_EXPIRES_IN=7d

# sqlite: chạy ngay không cần cài gì (mặc định khi chạy local)
# mysql : dùng khi chạy bằng Docker Compose
# mssql : SQL Server (điền MSSQL_* bên dưới; xem mục "Dùng SQL Server" trong README)
DB_DIALECT=sqlite
DB_STORAGE=./data/taskflow.sqlite

# Chỉ dùng khi DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=taskflow
DB_USER=root
DB_PASSWORD=taskflow123

# Địa chỉ giao diện (dùng cho link đặt lại mật khẩu admin tạo)
APP_URL=http://localhost:5180

# Đăng nhập bằng Google: dán Client ID (dạng ...apps.googleusercontent.com), để trống thì ẩn nút
GOOGLE_CLIENT_ID=

# Chỉ dùng khi DB_DIALECT=mssql (SQL Server bật TCP/IP cổng 1433 + đăng nhập bằng tài khoản SQL)
MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433
MSSQL_DB=TaskFlow
MSSQL_USER=taskflow_app
MSSQL_PASSWORD=

# ----- Cuộc gọi qua Internet: máy chủ trung chuyển TURN (tùy chọn) -----
# Không có TURN vẫn gọi được với phần lớn mạng; mạng 4G / wifi trường đôi khi cần TURN.
# Cách 1 – Cloudflare TURN (Dashboard Cloudflare > Calls > TURN, miễn phí 1000 GB/tháng):
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=
# Cách 2 – TURN bất kỳ (VD metered.ca):
# TURN_URLS=turn:global.relay.metered.ca:80,turns:global.relay.metered.ca:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
